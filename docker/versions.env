# Proposed robot-runtime lock. Do not change a value without an architecture
# decision record and physical target validation.
TARGET_PLATFORM=linux/arm64
JETSON_MODEL=jetson-orin-nano-8gb
JETPACK_VERSION=6.2.2
L4T_VERSION=36.5.0
UBUNTU_VERSION=22.04
ROS_DISTRO=humble
CUDA_VERSION=12.6
ZED_SDK_VERSION=5.2.3
ZED_ROS2_WRAPPER_VERSION=v5.2.2

# Resolve on the physical Jetson after the NVIDIA/Stereolabs validation gate.
ZED_ROS2_WRAPPER_COMMIT=TBD_AFTER_TARGET_VALIDATION
JETSON_RUNTIME_IMAGE=TBD_AFTER_TARGET_VALIDATION
JETSON_RUNTIME_IMAGE_DIGEST=TBD_AFTER_TARGET_VALIDATION

# This generic Ubuntu image is sufficient to build the Phase 0 package scaffold.
# It is not a substitute for the validated Jetson/ZED runtime image above.
CONTAINER_BASE_IMAGE=ubuntu:22.04
CONTAINER_BASE_IMAGE_DIGEST=TBD_AFTER_TARGET_VALIDATION
