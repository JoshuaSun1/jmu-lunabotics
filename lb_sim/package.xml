<?xml version="1.0"?>
<package format="3">
  <name>lb_sim</name>
  <version>0.1.0</version>
  <description>Mock hardware, mock sensors, test worlds, and bag replay support.</description>
  <maintainer email="team@example.com">JMU NASA Lunabotics Team</maintainer>
