Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.5
      Enabled: true
      Name: Reference Grid
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Rectified Webcam Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sensors/webcam/image_rect
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 0.5
      Frames:
        All Enabled: true
      Marker Scale: 0.2
      Name: Camera-relative Observation TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Axes Length: 0.25
      Axes Radius: 0.02
      Class: rviz_default_plugins/Pose
      Color: 255; 85; 0
      Enabled: false
      Head Length: 0.08
      Head Radius: 0.04
      Name: Latest Tag 1 Pose (disabled because Pose display does not expire)
      Shaft Length: 0.2
      Shaft Radius: 0.02
      Shape: Axes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visualization/webcam/tag_1_pose
      Value: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 25
      Enabled: true
      Head Diameter: 0.05
      Head Length: 0.03
      Length: 0.03
      Line Style: Lines
      Line Width: 0.02
      Name: Current Contiguous Tag 1 Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.02
      Shaft Length: 0.03
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visualization/webcam/tag_1_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: webcam_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.5
      Target Frame: webcam_optical_frame
      Yaw: 0.75
Window Geometry:
  Height: 900
  Width: 1500
