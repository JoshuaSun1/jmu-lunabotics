Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Alpha: 0.5
    Cell Size: 0.5
    Color: 100; 100; 100
    Enabled: true
    Name: 0.5 m Reference Grid
    Plane: XY
    Value: true
  - Alpha: 0.35
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Static Arena Map
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Alpha: 0.65
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Global Costmap (static + synthetic hazards + inflation)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap_updates
    Use Timestamp: false
    Value: true
  - Alpha: 0.8
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Local Rolling Costmap (static + synthetic hazards + inflation)
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap_updates
    Use Timestamp: false
    Value: true
  - Alpha: 1.0
    Class: rviz_default_plugins/Polygon
    Color: 255; 170; 0
    Enabled: true
    Name: Global Costmap Footprint (estimated)
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/published_footprint
    Value: true
  - Alpha: 1.0
    Class: rviz_default_plugins/Polygon
    Color: 0; 255; 255
    Enabled: true
    Name: Local Costmap Footprint (estimated)
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
    Value: true
  - Class: rviz_default_plugins/PoseWithCovariance
    Enabled: true
    Name: Fused Pose (synthetic measurement pass-through)
    Shape:
      Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Color: 255; 25; 0
      Head Length: 0.2
      Head Radius: 0.1
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Value: Arrow
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /localization/fused_pose
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 1
    Frames:
      All Enabled: true
    Marker Scale: 0.25
    Name: N3 Development TF (must remain current)
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/Path
    Name: Global Plan
    Enabled: true
    Line Style: Lines
    Line Width: 0.03
    Topic:
      Value: /plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 10
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Mock Arena Top-Down
      Scale: 85
      Target Frame: map
      X: 3.425
      Y: 2.5
Window Geometry:
  Height: 900
  Width: 1500
