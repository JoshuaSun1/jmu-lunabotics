# Robot software baseline. Physical target validation remains open.
TARGET_PLATFORM=linux/arm64
JETSON_MODEL=jetson-orin-nano-8gb
JETPACK_VERSION=7.2.1
L4T_VERSION=39.2.1
UBUNTU_VERSION=24.04
ROS_DISTRO=jazzy
CUDA_VERSION=13.2.2
ZED_SDK_VERSION=5.5.0
ZED_ROS2_WRAPPER_VERSION=v5.5.0

# Resolve on the physical Jetson after the NVIDIA/Stereolabs validation gate.
ZED_ROS2_WRAPPER_COMMIT=TBD_AFTER_TARGET_VALIDATION
